# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_BRIDGE_URL: Bayani App backend (bridge) base URL.
# Same backend the citizen app uses. Defaults to http://<same-host>:8000.
# Example for local dev: VITE_BRIDGE_URL="http://localhost:8000"
VITE_BRIDGE_URL="MY_BRIDGE_URL"

# Auto operator session (dev convenience): alert2 signs in on startup so
# Bayani App SOS frames appear with no manual login. Defaults match the
# backend's seeded account (admin/admin123). For shared setups, create a
# dedicated dispatcher account and put its credentials here instead.
VITE_RC_USERNAME="admin"
VITE_RC_PASSWORD="admin123"

VITE_GOOGLE_MAPS_API_KEY="AIzaSyCGT4kID1SO0zXbWlunh1K0xenIx2drEvc"
